    "GRAPHIFY_BACKEND": "none",
    "GRAPHIFY_NO_AUTO_REFRESH": "1",
    "GRAPHIFY_NO_TIPS": "1",
    "GRAPHIFY_NO_CTA": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
