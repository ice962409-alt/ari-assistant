<?xml version="1.0" encoding="utf-8"?>
<!-- Solo la Ari completa (la del dueño, la CEO) trabaja con su equipo de modelos. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Para hablar con los modelos de la laptop en la red Wi-Fi local. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Android solo deja leer el nombre de la red Wi-Fi con permiso de ubicación.
         Ari lo usa únicamente para saber si la red está aprobada. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Ajustes por voz (solo la Ari CEO): brillo y No molestar. Los das tú en pantallas de Android. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- "Darle todo a ARI": pedir con un toque que Android no la duerma (escuchar "Ari" con la pantalla apagada). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Agenda y fotos (solo la Ari CEO): guardar citas y mostrarte tus fotos y archivos. -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Uso del teléfono (solo la Ari CEO): tiempo en cada app y pasos del día. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Actualizarse desde GitHub: Android siempre pide confirmar la instalación. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- "busca el archivo…": Android 11+ pide "Acceso a todos los archivos" para ver documentos. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- usesCleartextTraffic: Ollama y LM Studio sirven HTTP sin cifrar. El único
         código de red (TeamAgent) solo se conecta a direcciones IPv4 privadas
         y solo en el hotspot del teléfono o en redes Wi-Fi aprobadas por el usuario. -->
    <!-- Game Boost (solo la Ari CEO): ver si Eden está instalado y su versión. Solo se lee. -->
    <queries>
        <package android:name="dev.eden.eden_emulator" />
        <package android:name="dev.eden.eden_emulator.nightly" />
        <package android:name="dev.legacy.eden_emulator" />
    </queries>

    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic">
        <!-- El instalador de Android avisa aquí si necesita tu confirmación. -->
        <receiver
            android:name="com.ari.assistant.AriUpdateReceiver"
            android:exported="false" />


        <!-- Solo la Ari CEO: envía los recados y maneja tus apps cuando se lo pides (Accesibilidad). -->
        <service
            android:name="com.ari.assistant.AriSendService"
            android:exported="true"
            android:label="@string/ari_send_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ari_send_service" />
        </service>
    </application>
</manifest>
