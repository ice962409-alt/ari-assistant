<?xml version="1.0" encoding="utf-8"?>
<!-- Mantén presionado el icono de Ari para entrar directo a platicar con ella. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="live"
        android:enabled="true"
        android:icon="@drawable/shortcut_live"
        android:shortcutShortLabel="@string/shortcut_live_short"
        android:shortcutLongLabel="@string/shortcut_live_long">
        <intent
            android:action="com.ari.assistant.LIVE"
            android:targetPackage="com.ari.assistant"
            android:targetClass="com.ari.assistant.LiveShortcutActivity" />
    </shortcut>
</shortcuts>
