<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de Ari. Solo usa vistas permitidas en RemoteViews (LinearLayout,
     TextView, ImageView, ViewFlipper). El ViewFlipper rota los mensajes solo,
     con las animaciones de res/anim. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:letterSpacing="0.15"
            android:text="ARI"
            android:textColor="@color/ari_green"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/ari_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <ViewFlipper
        android:id="@+id/widget_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:autoStart="true"
        android:flipInterval="4500"
        android:inAnimation="@anim/widget_in"
        android:outAnimation="@anim/widget_out">

        <TextView
            android:id="@+id/widget_line_1"
            style="@style/AriWidgetLine" />

        <TextView
            android:id="@+id/widget_line_2"
            style="@style/AriWidgetLine" />

        <TextView
            android:id="@+id/widget_line_3"
            style="@style/AriWidgetLine" />

        <TextView
            android:id="@+id/widget_line_4"
            style="@style/AriWidgetLine" />
    </ViewFlipper>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_open_ari"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:text="Hablar con Ari"
            android:textColor="@color/ari_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_open_board"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:text="Ver a Claude"
            android:textColor="@color/ari_green"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
