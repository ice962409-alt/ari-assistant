<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Para hablar con el modelo de la laptop en la red Wi-Fi local. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Android solo deja leer el nombre de la red Wi-Fi con permiso de ubicación.
         Ari lo usa únicamente para saber si la red está aprobada. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Recordatorios: notificaciones, alarmas a la hora exacta y reprogramarlas al reiniciar. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Pon una alarma a las 7": le pide a la app de reloj que la cree. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- "Llama a mamá": buscar el número en tus contactos. Se pide la primera vez que lo usas. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Modo live en segundo plano: Ari te sigue escuchando mientras usas otras apps,
         siempre con una notificación fija para terminar con un toque. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- "Mira mi pantalla": una sola imagen, siempre después de que tocas "Permitir". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Android 11+ solo deja ver los servicios de voz declarados aquí. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Para que Ari encuentre las apps instaladas cuando le dices "abre …". -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.google.android.youtube" />
        <package android:name="deezer.android.app" />
    </queries>

    <!-- usesCleartextTraffic: Ollama y LM Studio sirven HTTP sin cifrar. El único
         código de red (LaptopAgent) solo se conecta a direcciones IPv4 privadas
         y solo en el hotspot del teléfono o en redes Wi-Fi aprobadas por el usuario. -->
    <!-- configChanges: Ari no se reinicia al girar el teléfono, cambiar el tema o
         el tamaño de letra. Reiniciar volvería a cargar Gemma (3.4 GB) con la copia
         anterior aún en memoria, y Android cerraría la app por falta de memoria. -->
    <application
        android:allowBackup="false"
        android:label="Ari"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|fontScale|density|locale|layoutDirection"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Mantén presionado el icono: "Hablar con Ari". -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Puente del acceso directo: no se ve y no aparece en recientes. -->
        <activity
            android:name=".LiveShortcutActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Mantiene el modo live cuando sales de Ari (notificación fija con "Terminar"). -->
        <service
            android:name=".LiveSessionService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- "Mira mi pantalla": la pregunta de Android y el servicio que toma una sola imagen. -->
        <activity
            android:name=".ScreenConsentActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".ScreenGlanceService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- "Compartir → Ari" desde otras apps: imágenes, PDF, documentos y texto.
             Solo prepara el adjunto; nada se envía hasta que tú lo decides. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="Ari"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <!-- Por aquí la cámara le entrega a Ari la foto que tomas. No es accesible para otras apps;
             solo la cámara recibe permiso temporal para esa foto. -->
        <provider
            android:name=".CaptureProvider"
            android:authorities="com.ari.assistant.camara"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Botón "Hablar con Ari" en los ajustes rápidos. -->
        <service
            android:name=".AriLiveTile"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_live"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Lo que le contestas a Ari desde su chat de notificaciones. -->
        <receiver
            android:name=".AriChatReceiver"
            android:exported="false" />

        <!-- Recordatorios: avisan aunque Ari esté cerrada. -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".ReminderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Widget de Ari para la pantalla de inicio. -->
        <receiver
            android:name=".AriWidget"
            android:exported="true"
            android:label="Ari">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ari_widget_info" />
        </receiver>
    </application>
</manifest>
