<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Para hablar con el modelo de la laptop en la red Wi-Fi local. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Android solo deja leer el nombre de la red Wi-Fi con permiso de ubicación.
         Ari lo usa únicamente para saber si la red está aprobada. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Android 11+ solo deja ver los servicios de voz declarados aquí. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- usesCleartextTraffic: Ollama y LM Studio sirven HTTP sin cifrar. El único
         código de red (LaptopAgent) solo se conecta a direcciones IPv4 privadas
         y solo en el hotspot del teléfono o en redes Wi-Fi aprobadas por el usuario. -->
    <!-- configChanges: Ari no se reinicia al girar el teléfono, cambiar el tema o
         el tamaño de letra. Reiniciar volvería a cargar Gemma (3.4 GB) con la copia
         anterior aún en memoria, y Android cerraría la app por falta de memoria. -->
    <application
        android:allowBackup="false"
        android:label="Ari"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|fontScale|density|locale|layoutDirection"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Widget de Ari para la pantalla de inicio. -->
        <receiver
            android:name=".AriWidget"
            android:exported="true"
            android:label="Ari">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ari_widget_info" />
        </receiver>
    </application>
</manifest>
